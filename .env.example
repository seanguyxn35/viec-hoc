# Supabase (Project Settings -> API). Chỉ dùng publishable key (hoặc anon key ở project cũ).
# KHÔNG dùng secret key, service_role hay mật khẩu database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tài khoản thử cho Playwright. Chỉ để trong .env.local, không đưa lên Vercel/GitHub.
TEST_EMAIL_A=
TEST_PASSWORD_A=
TEST_EMAIL_B=
TEST_PASSWORD_B=
